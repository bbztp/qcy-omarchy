[Unit]
Description=QCY earbuds BLE daemon (qcyctld)
ConditionPathExists=%h/.local/bin/qcyctld

[Service]
Type=simple
# Seconds the BLE link is kept after the last request before it is released so
# the phone app can use the earbuds (0 = never release). Default 6; override
# with `systemctl --user edit qcyctld.service`:
#   [Service]
#   Environment=QCYCTL_IDLE_SECONDS=6
ExecStart=%h/.local/bin/qcyctld
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
